# Nebius Token Factory (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact Nemotron model IDs on Token Factory.
TESSERA_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
TESSERA_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
TESSERA_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Tavily (grounds the requirements brief with competitor research)
TAVILY_API_KEY=

# Guardrails: hard caps so agents can never loop or overspend
TESSERA_DB_PATH=tessera.db
TESSERA_MAX_ROUNDS=3
TESSERA_MAX_TOKENS_PER_PROJECT=400000
